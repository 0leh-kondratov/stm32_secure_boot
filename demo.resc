# demo.resc — эмуляция standalone demo (FreRTOS, 3 LEDe + UART) на STM32H743 в Renode
# Исходники: app/demo. Сборка: make demo → build/demo/demo.elf
#
# Проверка эмуляции без бутлоадера и подписи. Образ тот же, что прошивается make flash-demo.
#
# Запуск из корня проекта:
#   make demo-renode
#   renode demo.resc
# (make demo-renode — образ с автокомандами раз в 5 с: status + переключение LED3; иначе в Renode команды по telnet не работают из-за бага UART RX, renode#487.)
# Без GUI: renode --disable-gui demo.resc
#
# В окне usart3: "Demo UART OK", приглашение "FreeRTOS interactive...", затем раз в 5 с — статус LED и LED3 on/off (auto).
# На плате (make demo + flash-demo): telnet не нужен, команды вводятся по UART (help, led3 on и т.д.).
#
# --- GDB ---
# Подключение во втором терминале:
#   arm-none-eabi-gdb build/demo/demo.elf
#   (gdb) target remote :3334
#   (gdb) break main
#   (gdb) continue
# Или в Cursor: запустить renode demo.resc, затем F5 → конфигурация "Debug demo (Renode)".
#
# --- Состояние LED в Renode ---
# 1) В окне usart3 идёт лог: LED1=ON LED2=OFF LED3=OFF и т.д.
# 2) LED на NUCLEO active-low: в ODR 0 = горит, 1 = погашен.
#    (machine-0) sysbus ReadDoubleWord 0x58020414
#    → GPIOB ODR: бит 0 = LED1 (PB0), бит 14 = LED3 (PB14)
#    (machine-0) sysbus ReadDoubleWord 0x58021014
#    → GPIOE ODR: бит 1 = LED2 (PE1)
#    LED включён, если соответствующий бит ODR == 0.
#
# Лог Renode: 0=Noisy, 1=Debug, 2=Info, 3=Warning, 4=Error, 5=NoLog.
# logLevel 4 — только ошибки; скрывает WARNING (rcc, 0x2007FFxx, FMC, GPV).
# Для отладки: logLevel 0 или 1.

using sysbus
logLevel 3
mach create "stm32h7"
machine LoadPlatformDescription @platforms/cpus/stm32h743.repl

# Workaround: при xTaskCreate FreeRTOS пишет по 0x1FEADB00; в repl нет RAM по этому адресу — подключаем доп. область из .repl (в resc нельзя \n в строке)
# Доп. RAM 0x1FE00000 (workaround для xTaskCreate). Путь: из корня проекта или полный, напр. @/data/projects/stm32_secure_boot/demo_ram_extra.repl
machine LoadPlatformDescription @demo_ram_extra.repl

# Standalone demo по 0x08000000 (тот же образ, что прошивается на плату без бутлоадера)
sysbus LoadELF @build/demo/demo.elf

# Вывод в окно Renode
showAnalyzer usart3

# Ввод с клавиатуры: сокет-терминал на порту 12345. Подключиться: telnet localhost 12345 (или nc localhost 12345)
# Тогда ввод (help, led3 on и т.д.) попадёт в эмулированный UART.
emulation CreateServerSocketTerminal 12345 "uart_term" false
connector Connect sysbus.usart3 uart_term

# GDB-сервер на порту 3334 — подключиться: (gdb) target remote :3334
machine StartGdbServer 3334

start
