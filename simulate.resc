# simulate.resc — emulacja bootloadera na STM32H743 w Renode
#
# Uruchomienie z korzenia projektu (po zmontowaniu bootloadera i podpisanej aplikacji):
#   make -f bootloader/Makefile all
#   make signed-app
#   renode simulate.resc
#
# Bez podpisanej_aplikacji na 0x08010000, bootloader zwróci "fail: bad magic" i zatrzyma się.
# wyjście UART — w oknie „usart3”.

using sysbus
mach create "stm32h7"
machine LoadPlatformDescription @platforms/cpus/stm32h743.repl

# Bootloader na początku flasha
sysbus LoadELF @build/bootloader/bootloader.elf

# Podpisana aplikacja na 0x08010000 (nagłówek + obraz) — w przeciwnym razie Verify_signature: zła magia
sysbus LoadBinary @build/app/signed_app.bin 0x08010000

showAnalyzer usart3

# Serwer GDB na porcie 3333 — connect: (gdb) target remote :3333
# Następnie możesz umieścić pułapkę, rozpocząć monitorowanie, kontynuować
machine StartGdbServer 3333

# Mniejszy hałas z niezrealizowanych rejestrów RCC/rejestrów peryferyjnych
logLevel 3

start